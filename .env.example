# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# ЮKassa: тестовый ключ начинается с test_, боевой с live_
# Магазин → Настройки → Ключи API. Используются в api/_lib/yookassa.js
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram: токен от @BotFather, chat_id через /getUpdates
# Для канала или группы chat_id отрицательный, например -1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Без слэша на конце. Локально: http://localhost:3000
# Из него собирается return_url платежа: ${SITE_URL}/success.html
SITE_URL=http://localhost:3000

# Только для локальной отладки вебхука через туннель. В проде не выставлять.
# Работает лишь при SKIP_IP_CHECK=1 И NODE_ENV != production.
SKIP_IP_CHECK=

# NODE_ENV Vercel выставляет сам (production на боевом деплое) — вручную не задавать.
